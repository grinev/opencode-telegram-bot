# Test-run environment for browser-driven e2e checks.
# Copy to .tmp/e2e/home/.env and fill in the required values.
#
# This file is read only when the bot is started with
# OPENCODE_TELEGRAM_HOME pointing at .tmp/e2e/home (see run-test-bot.ps1),
# so it never affects your normal bot state. run-test-bot.ps1 copies it there
# and clears these keys from the process environment first, because dotenv does
# not override variables that already exist.

# --- Required ---

# Use a SEPARATE bot from @BotFather, not your production one.
TELEGRAM_BOT_TOKEN=

# Same Telegram account you are logged into in the browser profile.
TELEGRAM_ALLOWED_USER_ID=

OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=big-pickle

# OpenCode V2 by default; `run-test-bot -OpencodeVersion v1` starts one launch on V1.
# On V2 the launcher forces OPENCODE_SERVER_MODE=standalone, so /opencode_start
# runs a separate server on the URL below and does not register as the user's
# background service. A separate state home does not make --service safe; the
# launcher does not rely on it for that. Auto-restart stays off unless set here.
OPENCODE_SERVER_VERSION=v2
# OPENCODE_AUTO_RESTART_ENABLED=false

# Dedicated port on both versions, so test runs never collide with your own
# OpenCode (4096 on V1, 49374 on V2). The bot derives the serve port from this
# URL. stop-test-bot stops the recorded stand pid only when it is still the
# listener on this port.
OPENCODE_API_URL=http://127.0.0.1:4097

# --- E2E-specific: do not change without updating e2e/probes.js ---

# The probes match bot strings literally, so the locale must stay English.
# A finished run is marked by the run footer "{agent} · 🧠 {model} · 🕒 {duration}"
# in compact and normal mode alike, so keep the assistant footer on.
BOT_LOCALE=en

# Full diagnostics for log-delta correlation.
LOG_LEVEL=debug

# Keep more per-run log files around while iterating on scenarios.
LOG_RETENTION=30
