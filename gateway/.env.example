# Gateway HTTP listener. The Swarm service listens on the overlay network.
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_PORT=4096

# Fixed LAN OpenCode target. The gateway never accepts a destination from a request.
TARGET_IP_ADDRESS=192.168.1.50
TARGET_OPENCODE_PORT=4096

# Wake-on-LAN settings.
TARGET_MAC_ADDRESS=aa:bb:cc:dd:ee:ff
WOL_BROADCAST_ADDRESS=192.168.1.255
# Optional interface name or local IPv4 address used as the UDP source.
# WOL_INTERFACE=eth0

# Prefer a Docker secret file in production. The default file is
# /run/secrets/gateway_shared_secret.
# GATEWAY_SHARED_SECRET_FILE=/run/secrets/gateway_shared_secret
GATEWAY_SHARED_SECRET=

# Bounded readiness polling.
READINESS_TIMEOUT_MS=120000
READINESS_POLL_INTERVAL_MS=1000
READINESS_PROBE_TIMEOUT_MS=3000
